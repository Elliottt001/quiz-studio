{
  "name": "xlab-annual-quiz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "test": "node --test tests/server/*.test.mjs tests/platform/archive.test.mjs",
    "test:platform": "node --test tests/platform/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "migrate:platform": "node --env-file-if-exists=.env.platform scripts/platform-migrate.mjs",
    "bootstrap:platform": "node --env-file-if-exists=.env.platform scripts/platform-bootstrap.mjs",
    "start:platform": "node --env-file-if-exists=.env.platform src/platform/main.mjs",
    "build": "node scripts/build.mjs",
    "build:platform": "node scripts/build-platform.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "verify:campus": "node scripts/verify-campus.mjs",
    "start": "node --env-file-if-exists=.env.local src/server/main.mjs",
    "dev": "node --env-file-if-exists=.env.local --watch src/server/main.mjs",
    "check": "node --check src/server/main.mjs && node --check public/js/player.mjs && node --check public/js/admin.mjs && node --check public/js/display.mjs && find src/platform scripts -name '*.mjs' -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "nes.css": "2.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
