# Copy to .env.local only for direct local development. Do not commit real secrets.
HOST=127.0.0.1
PORT=4173
ADMIN_PASSWORD_HASH=replace-with-output-of-admin-password-script
# Public managed service: use its environment settings (see render.yaml).
# HOST=0.0.0.0
# DATA_DIR=/var/data
# TRUSTED_HTTPS_PROXY=1
# PUBLIC_ORIGIN=https://x-lab.game.elliotttzhang.cn
# PREVIEW_ORIGIN=https://the-actual-service-name.onrender.com
# Direct LAN mode requires a trusted certificate valid for its local domain.
# HOST=0.0.0.0
# TLS_CERT_PATH=/absolute/path/to/fullchain.pem
# TLS_KEY_PATH=/absolute/path/to/privkey.pem
# Campus server + local Nginx: use deploy/campus/game.env.example and the
# systemd template; CAMPUS_PROXY_ONLY=1 prevents a plaintext LAN listener.
